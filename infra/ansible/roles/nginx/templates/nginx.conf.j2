events {}

http {
    upstream webapp {
        server webapp:5000;
    }

    server {
        listen {{ nginx_port }};

        location / {
            proxy_pass {{ proxy_pass_target }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /healthz {
	    add_header Content-Type text/plain;
            return 200 "Environment: {{ environment_name }}\n";
        }
    }
}
